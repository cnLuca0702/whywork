{
  "name": "whywork",
  "productName": "WhyWork",
  "version": "0.1.0",
  "description": "WhyWork —— 本地优先的 AI 知识库（remio 复刻 · 纯本地 · BYOK）",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:core": "electron out/main/index.js --core-check",
    "check:extended": "electron out/main/index.js --extended-check",
    "check:cases": "electron out/main/index.js --run-cases",
    "pack:mac": "electron-builder --mac --dir --config electron-builder.config.cjs",
    "dist:mac": "electron-builder --mac dmg --config electron-builder.config.cjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "check:browser": "electron out/main/index.js --browser-check",
    "check:recovery": "node scripts/check-recovery.cjs",
    "build:share": "node scripts/build-share.cjs",
    "check:share": "node scripts/check-share.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@univerjs/preset-sheets-core": "^1.0.4",
    "@univerjs/presets": "^1.0.4",
    "antd": "^5.25.0",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "docx": "^9.11.0",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^2.4.2",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "linkedom": "^0.18.13",
    "mailparser": "^3.9.39",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.2",
    "marked": "^18.1.1",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.1.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.2",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "vega": "^6.4.0",
    "vega-lite": "^6.5.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/mailparser": "^3.9.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  }
}
